# ============================================================
#  Paradox — .gitignore
#  Исключает: venv, кеши, pcap, отчёты, бэкапы, одноразовые скрипты
#  Оставляет: исходный код, тесты, spec, tools/verify_all.py и др.
# ============================================================

# ---------- Python / venv ----------
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
profile.out

# ---------- IDE ----------
.idea/
.vscode/
*.iml
*.swp
*.swo
*~

# ---------- Pcap / данные ----------
*.pcap
*.pcapng
*.cap
*.pcap.bak
*_part1.pcap
*_part2.pcap

# ---------- PyInstaller ----------
build/
dist/

